{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cv-workspace:schema:person-meta",
  "title": "Metadatos de la persona (meta.yaml)",
  "description": "Locale primario, locales disponibles, versión del modelo y registro de consentimiento.",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "primaryLocale": {
      "type": "string",
      "enum": [
        "es",
        "en",
        "de",
        "fr",
        "pt",
        "it"
      ]
    },
    "locales": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "es",
          "en",
          "de",
          "fr",
          "pt",
          "it"
        ]
      }
    },
    "modelVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "consent": {
      "type": "object",
      "properties": {
        "grantedBy": {
          "type": "string"
        },
        "grantedAt": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "purpose": {
          "default": "Generación de CVs para postulaciones propias",
          "type": "string"
        }
      },
      "required": [
        "grantedBy",
        "grantedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "slug",
    "primaryLocale",
    "modelVersion"
  ],
  "additionalProperties": false
}
