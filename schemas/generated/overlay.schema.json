{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cv-workspace:schema:overlay",
  "title": "Overlay de postulación (applications/*/overlay.yaml)",
  "description": "Selección y reordenamiento por id sobre un arquetipo. Sólo puede tocar campos narrativos, nunca hechos.",
  "type": "object",
  "properties": {
    "extends": {
      "type": "string",
      "minLength": 1
    },
    "job": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "es",
        "en",
        "de",
        "fr",
        "pt",
        "it"
      ]
    },
    "theme": {
      "type": "string"
    },
    "basics": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sectionOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "contact",
          "summary",
          "skills",
          "work",
          "education",
          "certificates",
          "projects",
          "awards",
          "languages",
          "publications",
          "references",
          "interests"
        ]
      }
    },
    "sections": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "contact",
          "summary",
          "skills",
          "work",
          "education",
          "certificates",
          "projects",
          "awards",
          "languages",
          "publications",
          "references",
          "interests"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
            }
          },
          "order": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
            }
          },
          "overrides": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string"
                },
                "bullets": {
                  "type": "object",
                  "properties": {
                    "include": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                      }
                    },
                    "exclude": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                      }
                    },
                    "order": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                      }
                    },
                    "variant": {
                      "default": "default",
                      "type": "string",
                      "enum": [
                        "short",
                        "long",
                        "default"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "required": [
        "contact",
        "summary",
        "skills",
        "work",
        "education",
        "certificates",
        "projects",
        "awards",
        "languages",
        "publications",
        "references",
        "interests"
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxPages": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "bulletsPerRole": {
          "default": {
            "recent": 5,
            "mid": 3,
            "old": 2
          },
          "type": "object",
          "properties": {
            "recent": {
              "default": 5,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mid": {
              "default": 3,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "old": {
              "default": 2,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "maxWords": {
          "type": "integer",
          "minimum": 100,
          "maximum": 5000
        }
      },
      "additionalProperties": false
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pdf",
          "docx",
          "txt",
          "md",
          "html",
          "jsonresume"
        ]
      }
    },
    "fileNameTemplate": {
      "type": "string"
    }
  },
  "required": [
    "extends"
  ],
  "additionalProperties": false
}
