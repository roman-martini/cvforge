{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cv-workspace:schema:projects",
  "title": "Proyectos (projects.yaml)",
  "description": "Proyectos propios o de terceros, con highlights en el mismo formato que los bullets.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      },
      "highlights": {
        "default": [],
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
            },
            "outcome": {
              "type": "string",
              "minLength": 1
            },
            "metric": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "delta_pct",
                    "absolute",
                    "scope",
                    "frequency",
                    "scale",
                    "selectivity",
                    "duration",
                    "proxy_qualitative"
                  ]
                },
                "confidence": {
                  "type": "string",
                  "enum": [
                    "measured",
                    "estimated",
                    "self_reported"
                  ]
                }
              },
              "required": [
                "value",
                "type",
                "confidence"
              ],
              "additionalProperties": false
            },
            "method": {
              "type": "string"
            },
            "tags": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "priority": {
              "default": 50,
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "variants": {
              "type": "object",
              "properties": {
                "short": {
                  "type": "string"
                },
                "long": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "provenance": {
              "default": {
                "source": "human"
              },
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "human",
                    "llm_draft",
                    "llm_approved"
                  ]
                },
                "derivedFrom": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                },
                "approvedBy": {
                  "type": "string"
                },
                "approvedAt": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "verified": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "outcome"
          ],
          "additionalProperties": false
        }
      },
      "keywords": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "startDate": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        ]
      },
      "endDate": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        ]
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "roles": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "entity": {
        "type": "string"
      },
      "type": {
        "type": "string"
      },
      "tags": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "priority": {
        "default": 50,
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "visibility": {
        "default": "public",
        "type": "string",
        "enum": [
          "public",
          "private"
        ]
      }
    },
    "required": [
      "id",
      "name"
    ],
    "additionalProperties": false
  }
}
