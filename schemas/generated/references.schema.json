{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cv-workspace:schema:references",
  "title": "Referencias (references.yaml)",
  "description": "Sólo iniciales y rol: los datos de contacto de un tercero no viven en el repositorio.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
      },
      "initials": {
        "type": "string",
        "minLength": 1,
        "maxLength": 6
      },
      "role": {
        "type": "string",
        "minLength": 1
      },
      "company": {
        "type": "string"
      },
      "relationship": {
        "type": "string"
      },
      "tags": {
        "default": [],
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "priority": {
        "default": 50,
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      },
      "visibility": {
        "default": "private",
        "type": "string",
        "enum": [
          "public",
          "private"
        ]
      }
    },
    "required": [
      "id",
      "initials",
      "role"
    ],
    "additionalProperties": false
  }
}
