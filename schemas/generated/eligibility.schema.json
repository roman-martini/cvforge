{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cv-workspace:schema:eligibility",
  "title": "Elegibilidad (eligibility.yaml)",
  "description": "Permisos de trabajo, disponibilidad y pretensiones. Es la base para responder las knockout questions.",
  "type": "object",
  "properties": {
    "workAuthorization": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "citizen",
              "permanent_resident",
              "work_permit",
              "student_visa",
              "none"
            ]
          },
          "sponsorshipRequired": {
            "default": false,
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "countryCode",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "residence": {
      "type": "object",
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "countryCode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "timezone": {
          "type": "string"
        }
      },
      "required": [
        "city",
        "countryCode"
      ],
      "additionalProperties": false
    },
    "workModes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "remote",
          "hybrid",
          "onsite"
        ]
      }
    },
    "relocation": {
      "type": "object",
      "properties": {
        "willing": {
          "type": "boolean"
        },
        "regions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "willing"
      ],
      "additionalProperties": false
    },
    "noticePeriod": {
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unit": {
          "type": "string",
          "enum": [
            "days",
            "weeks",
            "months"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "compensation": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "basis": {
          "type": "string",
          "enum": [
            "gross_annual",
            "net_annual",
            "gross_monthly",
            "net_monthly",
            "hourly"
          ]
        },
        "visibility": {
          "default": "private",
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        }
      },
      "required": [
        "currency",
        "basis"
      ],
      "additionalProperties": false
    },
    "availableFrom": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "additionalProperties": false
}
