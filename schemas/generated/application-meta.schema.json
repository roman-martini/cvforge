{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cv-workspace:schema:application-meta",
  "title": "Estado de la postulación (applications/*/meta.yaml)",
  "description": "Timeline, artefactos enviados por SHA-256 y procedencia del build.",
  "type": "object",
  "properties": {
    "state": {
      "default": "draft",
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "ack",
        "screening",
        "tech",
        "onsite",
        "offer",
        "rejected",
        "ghosted"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "portal",
        "linkedin",
        "referral",
        "email",
        "other"
      ]
    },
    "timeline": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "sent",
              "ack",
              "screening",
              "tech",
              "onsite",
              "offer",
              "rejected",
              "ghosted"
            ]
          },
          "at": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "rejectedStage": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "pdf",
              "docx",
              "txt",
              "md",
              "html",
              "jsonresume"
            ]
          },
          "filename": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "pages": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "format",
          "filename",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "gitSha": {
          "type": "string"
        },
        "inputHash": {
          "type": "string"
        },
        "browser": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "theme": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
