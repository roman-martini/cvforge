{
  "name": "cv-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace de CVs profesionales: datos en YAML como única fuente de verdad, múltiples formatos de salida, adaptación por vacante y verificación ATS automatizada.",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "cv": "./src/cli.ts"
  },
  "scripts": {
    "cv": "node src/cli.ts",
    "validate": "node src/cli.ts validate",
    "build": "node src/cli.ts build",
    "lint:ats": "node src/cli.ts lint",
    "schema": "node src/scripts/gen-schemas.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node src/cli.ts doctor"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "deepmerge-ts": "^7.1.5",
    "docx": "^9.7.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.62.1",
    "preact": "^10.29.8",
    "preact-render-to-string": "^6.7.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jsonresume/schema": "1.3.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
